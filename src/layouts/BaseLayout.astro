---
import '../styles/global.css';
import '../styles/theme.css';
import '../styles/logo.css';
import '../styles/form.css';

interface Props { title?: string; }
const { title = 'Proyecto y Juventud' } = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Proyecto y Juventud acompaña las problemáticas de vecinos de Lanús." />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
