---
import '../styles/global.css';
import '../styles/theme.css';
import '../styles/logo.css';
import '../styles/form.css';
import '../styles/navigation.css';
import '../styles/content.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Organización Proyecto y Juventud en Lanús',
  description = 'Proyecto y Juventud acompaña reclamos y problemáticas de vecinos de Lanús, los presenta ante el Concejo Deliberante y les da visibilidad pública.',
  noindex = false,
  structuredData,
} = Astro.props;

const siteUrl = Astro.site?.href;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImageUrl = Astro.site ? new URL('/logo-horizontal.png', Astro.site).href : undefined;
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Organización Proyecto y Juventud',
  alternateName: 'Proyecto y Juventud',
  description: 'Organización civil que acompaña reclamos y problemáticas de vecinos de Lanús.',
  email: 'ongopyj@gmail.com',
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Lanús, Provincia de Buenos Aires, Argentina',
  },
  sameAs: ['https://www.facebook.com/share/1DCw6mrf9e/?mibextid=wwXIfr'],
  ...(siteUrl ? { url: siteUrl } : {}),
  ...(socialImageUrl ? { logo: socialImageUrl } : {}),
};
const schemas = [organizationSchema, ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [])];
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Organización Proyecto y Juventud" />
    <meta name="theme-color" content="#ffd400" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Organización Proyecto y Juventud" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && <meta property="og:image:width" content="1327" />}
    {socialImageUrl && <meta property="og:image:height" content="608" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <title>{title}</title>
    {schemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body><slot /></body>
</html>
