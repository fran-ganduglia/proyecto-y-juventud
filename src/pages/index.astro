---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Logo from '../components/Logo.astro';
import { mediaItems } from '../data/media';
import { documents } from '../data/documents';
---
<BaseLayout title="Proyecto y Juventud | Lanús">
  <main>
    <section class="hero" id="inicio">
      <Header />
      <div class="hero__content container">
        <p class="eyebrow">Organización civil · Lanús</p>
        <h1>Tu reclamo<br />merece ser<br /><em>escuchado.</em></h1>
        <p class="hero__intro">Recibimos las problemáticas de los vecinos de Lanús, las presentamos ante el Concejo Deliberante y trabajamos para darles visibilidad pública.</p>
        <div class="actions"><a class="button" href="#problematica">Contanos tu problemática</a><a class="text-link" href="#nosotros">Conocé nuestro trabajo <span>→</span></a></div>
      </div>
      <div class="hero__roots" aria-hidden="true"></div>
    </section>

    <section class="process" id="nosotros">
      <div class="container"><p class="section-kicker">Así trabajamos</p><h2>De tu barrio al Concejo Deliberante</h2>
        <div class="process__steps">
          <article><span class="process__number">01</span><h3>Recibimos</h3><p>Nos contás la problemática y reunimos la información necesaria.</p></article>
          <span class="arrow" aria-hidden="true">→</span>
          <article><span class="process__number">02</span><h3>Presentamos</h3><p>Canalizamos y presentamos formalmente el reclamo ante el Concejo Deliberante de Lanús.</p></article>
          <span class="arrow" aria-hidden="true">→</span>
          <article><span class="process__number">03</span><h3>Visibilizamos</h3><p>Buscamos difusión en medios locales, sitios web y YouTube para darle visibilidad pública.</p></article>
        </div>
      </div>
    </section>

    <section class="documents" id="casos"><div class="container"><p class="section-kicker">Transparencia</p><h2>Casos que denunciamos</h2><p class="documents__copy">Cada caso reúne la documentación disponible y sus repercusiones públicas, para que el recorrido sea verificable.</p>{documents.map((document) => <article class="document-card" id={document.caseId}><span class="document-card__icon" aria-hidden="true">PDF</span><div><p class="section-kicker">Caso documentado · Cementerio de Lanús</p><h3>{document.title}</h3><p>{document.summary}</p><div class="document-card__actions"><a class="button" href={document.file} target="_blank" rel="noopener">Ver documento</a><a class="text-link" href={document.file} download>Descargar PDF <span>↓</span></a></div></div></article>)}</div></section>

    <section class="media dark-section"><div class="container"><p class="section-kicker">Difusión pública</p><h2>El reclamo, en los medios</h2><div class="media-grid">{mediaItems.map((item) => <article class="media-card"><a href={item.href} target="_blank" rel="noopener noreferrer"><div class="media-card__source"><span>{item.kind}</span><span aria-hidden="true">↗</span></div><p class="demo-tag">{item.outlet}</p><h3>{item.title}</h3><span class="media-card__link">Abrir publicación</span></a></article>)}</div><div class="facebook-feature"><img src="/logo-compacto.png" alt="Logo de Proyecto y Juventud" loading="lazy" /><div><p class="section-kicker">Más acciones de la organización</p><h3>Visitá nuestra página en Facebook</h3><p>Conocé otros proyectos, reclamos y actividades de Proyecto y Juventud.</p><a class="button" href="https://www.facebook.com/share/1DCw6mrf9e/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer">Visitarnos en Facebook ↗</a></div></div></div></section>

    <section class="volunteer" id="participa"><div class="container volunteer__content"><h2>El cambio empieza<br />cuando nos unimos.</h2><p>Sumate como voluntario y ayudanos a construir un Lanús más justo para todos.</p><a class="button button--dark" href="#contacto">Quiero sumarme</a></div></section>

    <section class="form-section" id="problematica"><div class="container form-layout"><div><img class="logo-compacto" src="/logo-compacto.png" alt="Sello de Organización Proyecto y Juventud" loading="lazy" /><p class="section-kicker">Tu voz merece ser escuchada</p><h2>Contanos tu problemática</h2><p>Completá el formulario. Te contactaremos para conocer mejor el caso y evaluar cómo acompañarlo.</p><p class="notice">Proyecto y Juventud es una asociación civil y no reemplaza a organismos públicos, judiciales ni de emergencia.</p></div>
      <form id="problematicas-form" name="problematicas" method="post" action="/gracias/" data-netlify="true" netlify-honeypot="bot-field" aria-label="Formulario para contar una problemática"><input type="hidden" name="form-name" value="problematicas" /><p class="honeypot"><label>No completar este campo<input name="bot-field" /></label></p><label>Nombre y apellido<input name="name" autocomplete="name" required /></label><label>Email<input type="email" name="email" autocomplete="email" required /></label><label>Barrio o localidad<input name="location" required /></label><label>Descripción<textarea name="description" rows="4" required></textarea></label><label class="checkbox"><input type="checkbox" name="contact-consent" required /> <span>Acepto que me contacten por esta consulta.</span></label><label class="checkbox"><input type="checkbox" name="publication-consent" /> <span>Autorizo por separado la evaluación de información para una eventual publicación.</span></label><button class="button" type="submit">Enviar consulta</button><p class="form-note">La información se recibe de forma privada para evaluar el acompañamiento del caso.</p></form>
    </div></section>
  </main>
  <footer id="contacto"><div class="container footer__content"><a class="brand brand--panel" href="#inicio"><Logo loading="lazy" /></a><p>Datos de contacto institucionales<br />pendientes de confirmación.</p><a class="text-link" href="#problematica">Contanos tu problemática <span>→</span></a></div></footer>
</BaseLayout>
