---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { cases } from '../data/cases';
import { mediaItems } from '../data/media';
---
<BaseLayout title="Proyecto y Juventud | Lanús">
  <main>
    <section class="hero" id="inicio">
      <Header />
      <div class="hero__content container">
        <p class="eyebrow">Organización civil · Lanús</p>
        <h1>Tu reclamo<br />merece ser<br /><em>escuchado.</em></h1>
        <p class="hero__intro">Recibimos las problemáticas de los vecinos de Lanús, las presentamos ante el Concejo Deliberante y trabajamos para darles visibilidad pública.</p>
        <div class="actions"><a class="button" href="#problematica">Contanos tu problemática</a><a class="text-link" href="#nosotros">Conocé nuestro trabajo <span>→</span></a></div>
      </div>
      <div class="hero__roots" aria-hidden="true"></div>
    </section>

    <section class="process" id="nosotros">
      <div class="container"><p class="section-kicker">Así trabajamos</p><h2>De tu barrio al Concejo Deliberante</h2>
        <div class="process__steps">
          <article><span class="process__number">01</span><h3>Recibimos</h3><p>Nos contás la problemática y reunimos la información necesaria.</p></article>
          <span class="arrow" aria-hidden="true">→</span>
          <article><span class="process__number">02</span><h3>Presentamos</h3><p>Canalizamos y presentamos formalmente el reclamo ante el Concejo Deliberante de Lanús.</p></article>
          <span class="arrow" aria-hidden="true">→</span>
          <article><span class="process__number">03</span><h3>Visibilizamos</h3><p>Buscamos difusión en medios locales, sitios web y YouTube para darle visibilidad pública.</p></article>
        </div>
      </div>
    </section>

    <section class="dark-section" id="casos"><div class="container"><div class="section-heading"><div><p class="section-kicker">Trabajo verificable</p><h2>Casos que acompañamos</h2></div><p>Los contenidos publicados se revisan antes de difundirse.</p></div>
      <div class="card-grid">{cases.map((item) => <article class="case-card"><span class="demo-tag">Demo</span><p class="case-card__location">{item.location}</p><h3>{item.title}</h3><p>{item.summary}</p><div class="case-card__footer"><span class:list={["status", item.status.toLowerCase().replaceAll(' ', '-')]}> {item.status}</span><a href="#documentacion">Ver presentación →</a></div></article>)}</div>
    </div></section>

    <section class="documents" id="documentacion"><div class="container"><p class="section-kicker">Transparencia</p><h2>Documentación a la vista</h2><p class="documents__copy">Cada caso podrá vincularse con sus presentaciones y documentos públicos. No se publicarán datos personales sin revisión previa.</p><div class="document-placeholder"><span>▧</span><div><strong>Próximamente: documentos verificados</strong><p>Espacio preparado para visualizar o descargar presentaciones vinculadas a cada problemática.</p></div></div></div></section>

    <section class="media dark-section"><div class="container"><p class="section-kicker">Difusión pública</p><h2>Proyecto y Juventud en los medios</h2><div class="media-grid">{mediaItems.map((item) => <article class="media-card"><div class="media-card__image"><span>▶</span></div><p class="demo-tag">{item.outlet}</p><h3>{item.title}</h3></article>)}</div></div></section>

    <section class="volunteer" id="participa"><div class="container volunteer__content"><h2>El cambio empieza<br />cuando nos unimos.</h2><p>Sumate como voluntario y ayudanos a construir un Lanús más justo para todos.</p><a class="button button--dark" href="#contacto">Quiero sumarme</a></div></section>

    <section class="form-section" id="problematica"><div class="container form-layout"><div><img class="logo-compacto" src="/logo-compacto.png" alt="Sello de Organización Proyecto y Juventud" loading="lazy" /><p class="section-kicker">Tu voz merece ser escuchada</p><h2>Contanos tu problemática</h2><p>Completá el formulario. Te contactaremos para conocer mejor el caso y evaluar cómo acompañarlo.</p><p class="notice">Proyecto y Juventud es una asociación civil y no reemplaza a organismos públicos, judiciales ni de emergencia.</p></div>
      <form id="problematicas-form" method="post" aria-label="Formulario para contar una problemática"><label>Nombre y apellido<input name="name" autocomplete="name" required /></label><label>Email<input type="email" name="email" autocomplete="email" required /></label><label>Barrio o localidad<input name="location" required /></label><label>Descripción<textarea name="description" rows="4" required></textarea></label><label class="checkbox"><input type="checkbox" required /> <span>Acepto que me contacten por esta consulta.</span></label><label class="checkbox"><input type="checkbox" /> <span>Autorizo por separado la evaluación de información para una eventual publicación.</span></label><button class="button" type="submit">Enviar consulta</button><p class="form-note">Formulario preparado para conectar a un servicio seguro de envío.</p><p class="form-status" id="form-status" role="status" hidden></p></form>
    </div></section>
  </main>
  <footer id="contacto"><div class="container footer__content"><a class="brand" href="#inicio"><img class="logo-horizontal" src="/logo-horizontal.png" alt="Organización Proyecto y Juventud" loading="lazy" /></a><p>Datos de contacto institucionales<br />pendientes de confirmación.</p><a class="text-link" href="#problematica">Contanos tu problemática <span>→</span></a></div></footer>
  <script>
    const form = document.querySelector('#problematicas-form');
    const status = document.querySelector('#form-status');

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;
      if (status instanceof HTMLElement) {
        status.hidden = false;
        status.textContent = 'El canal seguro de envío todavía está en configuración. Tu información no fue enviada.';
      }
    });
  </script>
</BaseLayout>
