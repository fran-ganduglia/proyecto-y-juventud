---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Logo from '../components/Logo.astro';
import { cases } from '../data/cases';
import { mediaItems } from '../data/media';
import { documents } from '../data/documents';

const documentedCases = cases.map((communityCase) => ({
  ...communityCase,
  documents: documents.filter((document) => document.caseId === communityCase.id),
}));
---
<BaseLayout
  title="Proyecto y Juventud en Lanús | Reclamos vecinales"
  description="Proyecto y Juventud acompaña reclamos y problemáticas de vecinos de Lanús, los presenta ante el Concejo Deliberante y les da visibilidad pública."
>
  <Header />
  <main>
    <section class="hero" id="inicio">
      <div class="hero__content container">
        <p class="eyebrow">Organización civil · Lanús</p>
        <h1>Tu reclamo<br />merece ser<br /><em>escuchado.</em></h1>
        <p class="hero__intro">Recibimos las problemáticas de los vecinos de Lanús, las presentamos ante el Concejo Deliberante y trabajamos para darles visibilidad pública.</p>
        <div class="actions"><a class="button" href="#problematica">Contanos tu problemática</a><a class="text-link" href="#nosotros">Conocé nuestro trabajo <span>→</span></a></div>
      </div>
      <div class="hero__roots" aria-hidden="true"></div>
    </section>

    <section class="process" id="nosotros">
      <div class="container"><p class="section-kicker">Así trabajamos</p><h2>De tu barrio al Concejo Deliberante</h2>
        <div class="process__steps">
          <article><span class="process__number">01</span><h3>Recibimos</h3><p>Nos contás la problemática y reunimos la información necesaria.</p></article>
          <span class="arrow" aria-hidden="true">→</span>
          <article><span class="process__number">02</span><h3>Presentamos</h3><p>Canalizamos y presentamos formalmente el reclamo ante el Concejo Deliberante de Lanús.</p></article>
          <span class="arrow" aria-hidden="true">→</span>
          <article><span class="process__number">03</span><h3>Visibilizamos</h3><p>Buscamos difusión en medios locales, sitios web y YouTube para darle visibilidad pública.</p></article>
        </div>
      </div>
    </section>

    <section class="documents" id="casos"><div class="container"><p class="section-kicker">Transparencia</p><h2>Casos documentados</h2><p class="documents__copy">Cada caso reúne la información y los documentos disponibles para que el recorrido sea claro y verificable.</p>{documentedCases.map((communityCase) => <article class="document-case" id={`caso-${communityCase.id}`}><div class="document-case__header"><div><p class="section-kicker">Problemática · {communityCase.location}</p><h3>{communityCase.title}</h3></div><span class="status">{communityCase.status}</span></div><p class="document-case__summary">{communityCase.summary}</p><div class="document-case__documents"><p class="section-kicker">Documentos del caso</p>{communityCase.documents.map((document) => <div class="document-item" id={`documento-${document.id}`}><span class="document-card__icon" aria-hidden="true">PDF</span><div><h4>{document.title}</h4><p>{document.summary}</p><div class="document-card__actions"><a class="button" href={document.file} target="_blank" rel="noopener">Ver documento</a><a class="text-link" href={document.file} download>Descargar PDF <span>↓</span></a></div></div></div>)}</div></article>)}</div></section>

    <section class="media dark-section" id="medios"><div class="container"><div class="media-heading"><div><p class="section-kicker">Difusión pública</p><h2>El reclamo, en los medios</h2></div><p class="media-heading__copy">Cuando una problemática se hace visible, más vecinos pueden conocerla y acompañar el pedido.</p></div><div class="media-grid">{mediaItems.map((item, index) => <article class:list={["media-card", { "media-card--featured": index === 0 || index === 2 }]}><a href={item.href} target="_blank" rel="noopener noreferrer"><div class="media-card__top"><span class="media-card__index">0{index + 1}</span><span class="media-card__source">{item.kind}<span aria-hidden="true">↗</span></span></div><p class="media-card__outlet">{item.outlet}</p><h3>{item.title}</h3><span class="media-card__link">Abrir publicación <span aria-hidden="true">→</span></span></a></article>)}</div><div class="facebook-feature"><img src="/logo-compacto.png" alt="Logo de Proyecto y Juventud" loading="lazy" /><div class="facebook-feature__body"><p class="section-kicker">Seguinos</p><h3>Más acciones de la organización</h3><p>Conocé otros proyectos, reclamos y actividades de Proyecto y Juventud.</p><a class="button" href="https://www.facebook.com/share/1DCw6mrf9e/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer">Visitarnos en Facebook ↗</a></div></div></div></section>

    <section class="form-section" id="problematica"><div class="container form-layout"><div><img class="logo-compacto" src="/logo-compacto.png" alt="Sello de Organización Proyecto y Juventud" loading="lazy" /><p class="section-kicker">Tu voz merece ser escuchada</p><h2 class="form-title">Contanos tu problemática</h2><p>Completá el formulario. Te contactaremos para conocer mejor el caso y evaluar cómo acompañarlo.</p><p class="notice">Proyecto y Juventud es una asociación civil y no reemplaza a organismos públicos, judiciales ni de emergencia.</p></div>
      <form id="problematicas-form" name="problematicas" method="post" action="/gracias/" enctype="multipart/form-data" data-netlify="true" netlify-honeypot="bot-field" aria-label="Formulario para contar una problemática"><input type="hidden" name="form-name" value="problematicas" /><p class="honeypot"><label>No completar este campo<input name="bot-field" tabindex="-1" autocomplete="off" /></label></p><p class="form-mobile-heading">Formulario</p><label><span class="field-label-text">Nombre y apellido <span class="required-mark" aria-hidden="true">*</span></span><input name="name" autocomplete="name" required /></label><label><span class="field-label-text">Email <span class="required-mark" aria-hidden="true">*</span></span><input type="email" name="email" autocomplete="email" required /></label><label><span class="field-label-text">Teléfono / WhatsApp <span class="optional-mark">(opcional)</span></span><input type="tel" name="phone" autocomplete="tel" /></label><label><span class="field-label-text">Barrio o localidad <span class="required-mark" aria-hidden="true">*</span></span><input name="location" autocomplete="address-level2" required /></label><label><span class="field-label-text">Descripción <span class="required-mark" aria-hidden="true">*</span></span><textarea name="description" rows="5" required></textarea></label><label><span class="field-label-text">Fotos o documentación <span class="optional-mark">(opcional)</span></span><input type="file" name="attachments" accept="image/*,.pdf,.doc,.docx" /><span class="field-help">Podés adjuntar una imagen o documento si lo tenés disponible.</span></label><div class="consent-box"><label class="checkbox"><input type="checkbox" name="contact-consent" required /> <span>Acepto que Proyecto y Juventud me contacte para conversar sobre esta problemática.</span></label></div><button class="button" type="submit">Enviar consulta</button><p class="form-note">La información se recibe de forma privada y se usará para evaluar cómo acompañar el caso.</p></form>
    </div></section>
  </main>
  <footer id="contacto"><div class="container footer__content"><a class="brand brand--panel" href="#inicio"><Logo loading="lazy" /></a><div class="footer__contact"><a href="mailto:ongopyj@gmail.com">ongopyj@gmail.com</a><a class="footer__facebook" href="https://www.facebook.com/share/1DCw6mrf9e/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer"><span class="footer__facebook-icon" aria-hidden="true">f</span><span>Proyecto y Juventud en Facebook</span></a></div></div></footer>
</BaseLayout>
