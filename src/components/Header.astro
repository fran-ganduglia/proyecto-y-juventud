---
import Logo from './Logo.astro';

interface Props { dark?: boolean; }
const { dark = false } = Astro.props;
---
<header class:list={['site-header', { 'site-header--dark': dark }]}>
  <a class="brand brand--panel" href="/" aria-label="Proyecto y Juventud, inicio">
    <Logo />
  </a>
  <nav class="desktop-nav" aria-label="Navegación principal">
    <a href="/">Inicio</a><a href="/#nosotros">Nosotros</a><a href="/casos/">Casos</a><a href="/novedades/">Novedades</a><a href="/#contacto">Contacto</a>
  </nav>
  <a class="button button--small" href="/#problematica">Contanos tu problemática</a>
  <a class="mobile-cta" href="/#problematica">Contanos</a>
  <details class="mobile-menu">
    <summary><span class="sr-only">Abrir menú</span><span aria-hidden="true">☰</span></summary>
    <nav aria-label="Navegación móvil">
      <a href="/">Inicio</a><a href="/#nosotros">Nosotros</a><a href="/casos/">Casos</a><a href="/novedades/">Novedades</a>
      <a class="mobile-menu__cta" href="/#problematica">Contanos tu problemática</a>
    </nav>
  </details>
</header>
